{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/generated','dist/generated',{recursive:true});require('fs').cpSync('src/assets','dist/assets',{recursive:true})\"",
    "start": "node dist/server.js",
    "lint": "eslint src",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx ../prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@clerk/express": "^2.1.66",
    "@google/genai": "^2.13.0",
    "@prisma/client": "^6",
    "cors": "^2",
    "docx": "^9.7.1",
    "express": "^5",
    "express-rate-limit": "^7",
    "multer": "^2",
    "openai": "^4",
    "pdfkit": "^0.20.2",
    "socket.io": "^4",
    "swagger-jsdoc": "^6",
    "swagger-ui-express": "^5",
    "zod": "^3"
  },
  "devDependencies": {
    "@types/cors": "^2",
    "@types/express": "^5",
    "@types/multer": "^1",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "dotenv": "^17.4.2",
    "prisma": "6.19.3",
    "tsx": "^4",
    "typescript": "^5"
  }
}
