{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node -e \"require('fs').cpSync('src/generated','dist/generated',{recursive:true})\"",
    "start": "node dist/server.js",
    "lint": "eslint src",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx ../prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6",
    "bcryptjs": "^2",
    "cors": "^2",
    "express": "^5",
    "express-rate-limit": "^7",
    "google-auth-library": "^9",
    "jsonwebtoken": "^9",
    "openai": "^4",
    "socket.io": "^4",
    "swagger-jsdoc": "^6",
    "swagger-ui-express": "^5",
    "zod": "^3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2",
    "@types/cors": "^2",
    "@types/express": "^5",
    "@types/jsonwebtoken": "^9",
    "@types/node": "^20",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "dotenv": "^17.4.2",
    "prisma": "6.19.3",
    "tsx": "^4",
    "typescript": "^5"
  }
}
